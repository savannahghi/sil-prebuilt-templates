          "code": [
            {
              "system": "http://loinc.org",
              "code": "8480-6",
              "display": "Systolic blood pressure"
            }
          ],
          "text": "Systolic Blood Pressure"
        },
        {
          "type": "integer",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
              "valueCoding": {
                "system": "http://unitsofmeasure.org",
                "code": "mm[Hg]",
                "display": "millimeter of mercury"
              }
            }
          ],
          "linkId": "8462-4",
          "code": [
