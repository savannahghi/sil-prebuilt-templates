          "text": "Diastolic Blood Pressure"
        }
      ]
    },
    {
      "type": "integer",
      "linkId": "8310-5",
      "text": "Temperature (Celsius)",
      "code": [
        {
          "system": "http://loinc.org",
          "code": "8310-5",
          "display": "Body Temperature"
        }
      ],
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
          "valueCoding": {
            "system": "http://unitsofmeasure.org",
            "code": "Cel",
            "display": "degree Celsius"
          }
        },
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-maxValue",
          "valueInteger": 40
        },
        {
          "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
          "valueInteger": 40
        }
      ],
      "item": [
        {
          "type": "string",
          "linkId": "8310-5_status",
          "text": "Temperature status",
          "readOnly": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "description": "Classify temperature as low, normal, or high with message, hide if > 40",
                "language": "text/fhirpath",
                "expression": "iif(%temperature.empty() or %temperature > 40, null, iif(%temperature < 35, 'Low. Normal range 35.0 to 37.5 °C', iif(%temperature > 37.5, 'High. Normal range 35.0 to 37.5 °C', 'Normal')))"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "integer",
      "linkId": "20564-1",
      "text": "Oxygen Saturation",
      "code": [
        {
          "system": "http://loinc.org",
          "code": "20564-1",
          "display": "Oxygen saturation in Blood"
        }
      ],
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
          "valueCoding": {
            "system": "http://unitsofmeasure.org",
            "code": "%",
            "display": "%"
          }
        },
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-maxValue",
          "valueInteger": 100
        },
        {
          "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
          "valueInteger": 100
        }
      ],
      "item": [
        {
          "type": "string",
          "linkId": "20564-1_status",
          "text": "Oxygen saturation status",
          "readOnly": true,
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "description": "Classify oxygen saturation, hide if > 100",
                "language": "text/fhirpath",
                "expression": "iif(%spo2.empty() or %spo2 > 100, null, iif(%spo2 < 90, 'Low. Expected 95 to 100 %. Recheck probe position and retake measurement.', iif(%spo2 >= 95, 'Normal', 'Borderline')))"
              }
            }
          ]
        }
      ]
    },
