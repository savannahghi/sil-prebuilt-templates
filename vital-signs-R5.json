  "meta": {
    "profile": [
      "http://hl7.org/fhir/4.0/StructureDefinition/Questionnaire"
    ]
  },
  "extension": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "weight",
        "language": "text/fhirpath",
        "expression": "%resource.item.where(linkId='29463-7').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "heightM",
        "language": "text/fhirpath",
        "expression": "%resource.item.where(linkId='8302-2').answer.value / 100"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "temperature",
        "language": "text/fhirpath",
        "expression": "%resource.item.where(linkId='8310-5').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/variable",
      "valueExpression": {
        "name": "spo2",
        "language": "text/fhirpath",
        "expression": "%resource.item.where(linkId='20564-1').answer.value"
      }
    },
    {
      "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-targetStructureMap",
      "valueCanonical": "http://example.org/StructureMap/ExtractPhysicalAssessment"
    }
  ],
  "title": "Vitals Signs",
  "status": "active",
  "description": "This form is used to collect vital signs",
  "code": [
    {
      "system": "http://loinc.org",
      "code": "67795-5",
      "display": "Vital signs, weight, height, head circumference and oximetry panel HITSP"
    }
  ],
  "item": [
    {
      "type": "integer",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
          "valueCoding": {
            "system": "http://unitsofmeasure.org",
            "code": "cm",
            "display": "centimeter"
          }
        }
      ],
      "linkId": "8302-2",
      "code": [
        {
          "system": "http://loinc.org",
          "code": "8302-2",
          "display": "Body Height"
        }
      ],
      "text": "Height"
    },
    {
      "type": "integer",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
          "valueCoding": {
            "system": "http://unitsofmeasure.org",
            "code": "kg",
            "display": "kilogram"
          }
        }
      ],
      "linkId": "29463-7",
      "code": [
        {
          "system": "http://loinc.org",
          "code": "29463-7",
          "display": "Body Weight"
        }
      ],
      "text": "Weight"
    },
    {
      "type": "decimal",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
          "valueCoding": {
            "system": "http://unitsofmeasure.org",
            "code": "kg/m2",
            "display": "kilogram per square meter"
          }
        },
        {
          "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
          "valueExpression": {
            "description": "BMI in kg/m2, 1 decimal place",
            "language": "text/fhirpath",
            "expression": "iif(%heightM.empty() or %weight.empty(), null, (%weight / (%heightM.power(2))).round(1))"
          }
        }
      ],
      "linkId": "39156-5",
      "code": [
        {
          "system": "http://loinc.org",
          "code": "39156-5",
          "display": "Body mass index (BMI) [Ratio]"
        }
      ],
      "text": "BMI",
      "readOnly": true,
      "item": [
        {
          "type": "string",
          "extension": [
            {
              "url": "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-calculatedExpression",
              "valueExpression": {
                "description": "Classify BMI as underweight, normal, overweight, or obese",
                "language": "text/fhirpath",
                "expression": "iif(%heightM.empty() or %weight.empty(), null, iif((%weight / (%heightM.power(2))) < 18.5, 'Underweight', iif((%weight / (%heightM.power(2))) < 25, 'Normal', iif((%weight / (%heightM.power(2))) < 30, 'Overweight', 'Obese'))))"
              }
            }
          ],
          "linkId": "39156-5_status",
          "text": "BMI status",
          "readOnly": true
        }
      ]
    },
    {
      "type": "integer",
      "extension": [
        {
          "url": "http://hl7.org/fhir/StructureDefinition/questionnaire-unit",
          "valueCoding": {
            "system": "http://unitsofmeasure.org",
            "code": "/min",
            "display": "per minute"
          }
        }
      ],
      "linkId": "8889-8",
      "code": [
        {
          "system": "http://loinc.org",
          "code": "8889-8",
          "display": "Heart rate by Pulse oximetry"
        }
      ],
      "text": "Pulse Rate"
    },
    {
      "type": "group",
      "linkId": "55284-4",
      "code": [
        {
          "system": "http://loinc.org",
          "code": "55284-4",
          "display": "Blood pressure systolic and diastolic"
        }
      ],
      "text": "Blood Pressure(mmHg)",
      "readOnly": true,
