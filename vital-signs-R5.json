              "valueExpression": {
                "description": "Classify oxygen saturation",
                "language": "text/fhirpath",
                "expression": "iif(%spo2.empty(), null, iif(%spo2 < 90, 'Low. Expected 95 to 100 %. Recheck probe position and retake measurement.', iif(%spo2 >= 95, 'Normal', 'Borderline')))"
