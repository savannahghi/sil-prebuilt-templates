                "language": "text/fhirpath",
                "expression": "iif(%temperature.empty(), null, iif(%temperature < 35, 'Low. Normal range 35.0 to 37.5 °C', iif(%temperature > 37.5, 'High. Normal range 35.0 to 37.5 °C', 'Normal')))"
